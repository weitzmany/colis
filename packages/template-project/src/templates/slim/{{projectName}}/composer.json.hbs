{
  "name": "{{kebab projectName}}/{{kebab projectName}}",
  "description": "{{projectDescription}}",
  "type": "project",
  "require": {
    "php": "^8.1",
    "slim/slim": "^4.12.0",
    "slim/psr7": "^1.6.0",
    "php-di/php-di": "^6.1.0",
    "monolog/monolog": "^3.5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.0",
    "phpstan/phpstan": "^1.10.0",
    "squizlabs/php_codesniffer": "^3.7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S localhost:{{port}} -t public public/index.php",
    "test": "phpunit",
    "analyse": "phpstan analyse src",
    "cs-check": "phpcs --standard=PSR12 src",
    "cs-fix": "phpcbf --standard=PSR12 src"
  },
  {{#if author}}
  "authors": [
    {
      "name": "{{author}}"
    }
  ],
  {{/if}}
  {{#if license}}
  "license": "{{license}}",
  {{/if}}
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
