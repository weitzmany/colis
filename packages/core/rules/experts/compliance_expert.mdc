### Data Deletion (Right to be Forgotten)
```php
// ✅ DO: Implement data deletion
class DataDeletionService
{
    public function deleteUserData(int $userId, string $reason): void
    {
        // Log deletion request
        $this->auditLogger->log('data_deletion_requested', [
            'user_id' => $userId,
            'reason' => $reason,
            'timestamp' => date('c')
        ]);
        
        // Delete personal data
        $this->deletePersonalInformation($userId);
        
        // Anonymize analytics data (may be required to keep)
        $this->anonymizeAnalytics($userId);
        
        // Delete user account
        $this->userRepository->delete($userId);
        
        // Confirm deletion
        $this->auditLogger->log('data_deleted', [
            'user_id' => $userId,
            'timestamp' => date('c')
        ]);
    }
    
    private function anonymizeAnalytics(int $userId): void
    {
        // Keep analytics but remove personal identifiers
        $this->db->exec("
            UPDATE game_sessions 
            SET user_id = NULL 
            WHERE user_id = :user_id
        ", ['user_id' => $userId]);
    }
}
```

