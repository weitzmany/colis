#!/usr/bin/env node

/**
 * Project Initialization CLI Entry Point
 */

const { program } = require('commander');
const { initCommand } = require('../dist/features/project-initialization/cli/commands/init');

program
  .name('init')
  .description('Initialize project with rules, commands, and Port Manager')
  .version('1.0.0')
  .option('-p, --project-name <name>', 'Project name (auto-detected if not provided)')
  .option('-t, --app-type <type>', 'App type (auto-detected if not provided)')
  .option('--overwrite', 'Overwrite existing files')
  .option('--skip-existing', 'Skip existing files (default)')
  .option('--skip-port-manager', 'Skip Port Manager initialization (not recommended)')
  .option('--skip-rules', 'Skip copying rules')
  .option('--skip-commands', 'Skip copying commands')
  .option('--skip-defaults', 'Skip prompting to install default frameworks')
  .option('--dry-run', 'Show what would be done without making changes')
  .action(initCommand);

program.parse();
