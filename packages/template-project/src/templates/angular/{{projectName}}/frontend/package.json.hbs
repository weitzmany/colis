    "@angular/forms": "^{{#if angularVersions}}{{angularVersions.angular}}{{else}}21.0.0{{/if}}",
    "@angular/platform-browser": "^{{#if angularVersions}}{{angularVersions.angular}}{{else}}21.0.0{{/if}}",
