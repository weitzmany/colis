## Compliance Implementation

### Age Verification
```typescript
// ✅ DO: Implement age verification
interface AgeVerification {
  age: number;
  verified: boolean;
  method: 'self_report' | 'parental_consent' | 'school_verification';
  consentDate?: Date;
}

class AgeVerificationService {
  verifyAge(birthDate: Date): AgeVerification {
    const age = this.calculateAge(birthDate);
    
    if (age < 13) {
      // COPPA applies - require parental consent
      return {
        age,
        verified: false,
        method: 'parental_consent',
        requiresConsent: true
      };
    } else if (age < 16) {
      // GDPR - may require parental consent in some regions
      return {
        age,
        verified: false,
        method: 'parental_consent',
        requiresConsent: this.isEUResident()
      };
    }
    
    return {
      age,
      verified: true,
      method: 'self_report'
    };
  }
}
```

### Parental Consent Workflow
```typescript
// ✅ DO: Implement parental consent
interface ParentalConsent {
  childId: string;
  parentEmail: string;
  consentGiven: boolean;
  consentDate: Date;
  consentMethod: 'email' | 'phone' | 'school';
  verified: boolean;
}

class ConsentService {
  async requestParentalConsent(childEmail: string, parentEmail: string): Promise<void> {
    // Send consent request email
    const consentToken = this.generateConsentToken();
    
    await this.emailService.send({
      to: parentEmail,
      subject: 'Parental Consent Required',
      template: 'parental-consent',
      data: {
        childEmail,
        consentLink: `${this.baseUrl}/consent/${consentToken}`,
        privacyPolicyLink: `${this.baseUrl}/privacy`
      }
    });
    
    // Store pending consent
    await this.storePendingConsent(childEmail, consentToken);
  }
  
  async verifyConsent(token: string): Promise<boolean> {
    const consent = await this.getConsentByToken(token);
    
    if (!consent || consent.expired) {
      return false;
    }
    
    // Verify parent identity (email verification, etc.)
    const verified = await this.verifyParentIdentity(consent.parentEmail);
    
    if (verified) {
      await this.recordConsent(consent);
      return true;
    }
    
    return false;
  }
}
```

### Data Minimization
```php
// ✅ DO: Collect only necessary data
class DataCollectionPolicy
{
    // COPPA: Collect only what's necessary
    private array $allowedDataFields = [
        'age_range', // Not exact age
        'game_progress', // Learning progress
        'quiz_results', // Educational outcomes
        // NOT allowed:
        // 'full_name',
        // 'address',
        // 'phone_number',
        // 'email' (unless for account, with consent)
    ];
    
    public function canCollect(string $field, int $userAge): bool
    {
        if ($userAge < 13) {
            // COPPA: Stricter rules
            return in_array($field, $this->getCOPPAAllowedFields());
        }
        
        return in_array($field, $this->allowedDataFields);
    }
    
    private function getCOPPAAllowedFields(): array
    {
        return [
            'age_range', // e.g., "8-12"
            'game_progress', // Educational data
            'quiz_results' // Learning outcomes
        ];
    }
}
```

