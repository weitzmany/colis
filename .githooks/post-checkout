#!/usr/bin/env bash

### THIS IS A GIT HOOK THAT SETS THE COLOR SCHEME BASED ON THE BRANCH ###
### 1. Go to repository root directory
### cd /path/to/your/repo
### 2. Create .githooks directory if it doesn't exist
### mkdir -p .githooks
### 3. Set the .githooks directory as the core.hooksPath
### git config core.hooksPath .githooks
### 4. Verify the core.hooksPath
### git config core.hooksPath
### expected output: .githooks
### 5. Copy the post-checkout hook to the .githooks directory
### cp /path/to/this/repo/.githooks/post-checkout .githooks/post-checkout
### 6. copy the colors from the .vscode/settings.json file to the post-checkout hook
### 7. Make the hook executable
### chmod +x .githooks/post-checkout
### 8. Verify the hook
### ls -l .githooks/post-checkout
### expected output: -rwxr-xr-x ... (important: -x permission)
### 9. verify settings.json is ignored by git
### git check-ignore .vscode/settings.json
### expected output: .vscode/settings.json
### 10. if the file is not ignored, remove it:
### git rm --cached .vscode/settings.json
### 11. verify the file is ignored:
### git check-ignore .vscode/settings.json
### expected output: .vscode/settings.json
### 12. verify the hook is working:
### git checkout <branch>
### expected output: the color scheme is set based on the branch

set -e

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
SETTINGS_FILE=".vscode/settings.json"

# 🔧 CHANGE THESE TWO COLORS
MAIN_COLOR="#0b0b0b"        # red for main
MAIN_BG="#ed3535"
MAIN_INACTIVE="#ec7272cc" 

PROJECT_COLOR="#062015"     # your project color
PROJECT_INACTIVE="#81ca95cc"
PROJECT_BG="#81ca95"

BORDER="#5aa978"
DARKER_BG="#0b1f17"
DARK_BG="#071a13"
ACTIVE_COLOR="#ffffff"

echo "BRANCH: $BRANCH"
echo "Current branch is: $BRANCH"

mkdir -p .vscode

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  COLOR="$MAIN_COLOR"
  INACTIVE="$MAIN_INACTIVE"
  BG="$MAIN_BG"
else
  COLOR="$PROJECT_COLOR"
  INACTIVE="$PROJECT_INACTIVE"
  BG="$PROJECT_BG"
fi

cat > "$SETTINGS_FILE" <<EOF
{
    "workbench.colorCustomizations": {
      /* Title bar */
      "titleBar.activeBackground": "$BG",
      "titleBar.activeForeground": "$COLOR",
      "titleBar.inactiveBackground": "$INACTIVE",
      "titleBar.inactiveForeground": "$COLOR",
  
      /* Status bar */
      "statusBar.background": "$PROJECT_BG",
      "statusBar.foreground": "$PROJECT_COLOR",
      "statusBar.border": "$BORDER",
  
      /* Activity bar */
      "activityBar.background": "$DARKER_BG",
      "activityBar.foreground": "$PROJECT_BG",
      "activityBar.activeBorder": "$PROJECT_BG",
  
      /* Sidebar */
      "sideBar.background": "$DARK_BG",
      "sideBar.border": "$BORDER",
  
      /* Editor & panels frame */
      "editorGroup.border": "$BORDER",
      "panel.border": "$BORDER",
  
      /* Focus & highlights */
      "focusBorder": "$PROJECT_BG",
  
      /* Tabs */
      "tab.activeBorderTop": "$PROJECT_BG",
      "tab.activeForeground": "$ACTIVE_COLOR"
    }
  }
  
EOF
