# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.ts text
*.js text
*.jsx text
*.tsx text
*.json text
*.md text
*.yaml text
*.yml text

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
