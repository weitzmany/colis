#!/usr/bin/env node

/**
 * Create Project CLI Entry Point
 * 
 * Main entry point for creating new projects from templates
 */

const { program } = require('commander');
const { createCommand } = require('../dist/cli/commands/create');

program
  .name('create-project')
  .description('Create a new project from a template')
  .version('1.0.0');

program
  .command('create')
  .alias('new')
  .description('Create a new project')
  .argument('[project-name]', 'Project name')
  .option('-t, --template <type>', 'Template type (angular, slim, full-stack, frontend, backend, api)', 'angular')
  .option('-p, --package-manager <manager>', 'Package manager (npm, yarn, pnpm)', 'npm')
  .option('--skip-deps', 'Skip dependency installation')
  .option('--skip-git', 'Skip git initialization')
  .option('--skip-init', 'Skip Project Initialization (not recommended)')
  .option('--overwrite', 'Overwrite existing files')
  .option('--skip-existing', 'Skip existing files (default)')
  .option('--dry-run', 'Show what would be created without making changes')
  .option('-d, --description <text>', 'Project description')
  .option('-a, --author <name>', 'Author name')
  .option('-l, --license <type>', 'License type (MIT, Apache-2.0, etc.)')
  .action(async (projectName, options) => {
    await createCommand({
      projectName,
      template: options.template,
      packageManager: options.packageManager,
      skipDeps: options.skipDeps,
      skipGit: options.skipGit,
      skipInit: options.skipInit,
      overwrite: options.overwrite,
      skipExisting: options.skipExisting,
      dryRun: options.dryRun,
      description: options.description,
      author: options.author,
      license: options.license,
    });
  });

// Default command
program
  .action(async (projectName) => {
    if (projectName) {
      await createCommand({ projectName });
    } else {
      program.help();
    }
  });

program.parse(process.argv);
