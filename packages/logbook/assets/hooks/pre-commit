#!/bin/sh
# Pre-commit hook - Run linting, type checking, and formatting validation
# Part of @colis/logbook package
# Version: 1.0.0

set -e

echo "🔍 Running pre-commit checks..."

# Check if npm/yarn/pnpm is available
if command -v npm >/dev/null 2>&1; then
  PKG_MANAGER="npm"
elif command -v yarn >/dev/null 2>&1; then
  PKG_MANAGER="yarn"
elif command -v pnpm >/dev/null 2>&1; then
  PKG_MANAGER="pnpm"
else
  echo "⚠️  No package manager found. Skipping pre-commit checks."
  exit 0
fi

# Run linting if lint script exists
if $PKG_MANAGER run --silent lint --help >/dev/null 2>&1; then
  echo "  → Running linter..."
  $PKG_MANAGER run lint
else
  echo "  ⊘ No lint script found. Skipping."
fi

# Run type checking if typecheck script exists
if $PKG_MANAGER run --silent typecheck --help >/dev/null 2>&1; then
  echo "  → Running type checker..."
  $PKG_MANAGER run typecheck
else
  echo "  ⊘ No typecheck script found. Skipping."
fi

# Run format check if format:check script exists
if $PKG_MANAGER run --silent format:check --help >/dev/null 2>&1; then
  echo "  → Checking formatting..."
  $PKG_MANAGER run format:check
else
  echo "  ⊘ No format:check script found. Skipping."
fi

echo "✅ Pre-commit checks passed!"
exit 0
