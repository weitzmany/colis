## Question and Assessment Analytics

### Item Analysis

```typescript
interface ItemAnalysis {
  questionId: string;
  difficulty: number; // 0-1, proportion correct
  discrimination: number; // Point-biserial correlation
  distractorAnalysis: DistractorStats[];
  validityScore: number;
  recommendations: string[];
}

// Analyze question quality
function analyzeQuestion(questionId: string, responses: Response[]): ItemAnalysis {
  const difficulty = responses.filter(r => r.isCorrect).length / responses.length;
  const discrimination = calculatePointBiserial(questionId, responses);
  const distractors = analyzeDistractors(questionId, responses);
  
  const recommendations = [];
  if (difficulty > 0.9) recommendations.push('Question may be too easy');
  if (difficulty < 0.3) recommendations.push('Question may be too hard');
  if (discrimination < 0.2) recommendations.push('Low discrimination - review question');
  
  return { questionId, difficulty, discrimination, distractorAnalysis: distractors, validityScore: discrimination, recommendations };
}
```

