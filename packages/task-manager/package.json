    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.5.0",
    "zod": "^3.22.0"
  }
}
