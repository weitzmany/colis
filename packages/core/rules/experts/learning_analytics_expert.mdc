## Analytics Patterns

### Learner Performance Tracking

```typescript
interface LearnerPerformance {
  userId: string;
  assessments: AssessmentResult[];
  masteryLevels: Map<string, MasteryLevel>;
  engagementMetrics: EngagementData;
  predictedOutcome: PredictedOutcome;
}

interface MasteryLevel {
  topic: string;
  level: 'novice' | 'developing' | 'proficient' | 'advanced' | 'expert';
  confidence: number; // 0-1
  lastAssessed: Date;
  trend: 'improving' | 'stable' | 'declining';
}

// Calculate mastery level from assessment data
function calculateMastery(assessments: AssessmentResult[], topic: string): MasteryLevel {
  const topicAssessments = assessments.filter(a => a.topic === topic);
  const recentAssessments = topicAssessments.slice(-5);
  
  const averageScore = recentAssessments.reduce((sum, a) => sum + a.score, 0) / recentAssessments.length;
  const trend = calculateTrend(topicAssessments);
  
  return {
    topic,
    level: scoreToMasteryLevel(averageScore),
    confidence: calculateConfidence(topicAssessments),
    lastAssessed: recentAssessments[recentAssessments.length - 1].date,
    trend
  };
}
```

