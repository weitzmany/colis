{
  "name": "@colis/logbook",
  "version": "1.0.0",
  "description": "Standardized git workflow assets and lifecycle management tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "git-workflow": "./bin/git-workflow"
  },
  "exports": {
    ".": "./dist/index.js",
    "./lifecycle": "./dist/lifecycle/index.js",
    "./utils": "./dist/utils/index.js"
  },
  "files": [
    "dist",
    "assets",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "git",
    "workflow",
    "github",
    "gh",
    "hooks",
    "conventional-commits",
    "git-hooks",
    "github-cli"
  ],
  "author": "Colis",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "fs-extra": "^11.2.0",
    "simple-git": "^3.22.0",
    "execa": "^5.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "@colis/rig": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@colis/rig": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
