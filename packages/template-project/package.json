{
  "name": "@your-org/template-project",
  "version": "1.0.0",
  "type": "module",
  "description": "Project template package for scaffolding new projects with standard structure and best practices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "create-project": "./bin/create-project"
  },
  "exports": {
    ".": "./dist/index.js",
    "./features/template-engine": "./dist/features/template-engine/index.js"
  },
  "files": [
    "dist",
    "bin",
    "src/templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "template",
    "scaffold",
    "project-generator",
    "starter",
    "boilerplate"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@your-org/core": "file:../core",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "inquirer": "^9.2.12"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/handlebars": "^4.1.0",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
