## Angular i18n Implementation

### Translation Files Structure
```json
// assets/i18n/en.json
{
  "quiz": {
    "title": "Quiz Game",
    "question": "Question",
    "of": "of",
    "submit": "Submit Answer",
    "next": "Next Question",
    "score": "Score",
    "correct": "Correct!",
    "incorrect": "Incorrect. Try again!"
  },
  "errors": {
    "network": "Network error. Please try again.",
    "notFound": "Resource not found"
  }
}

// assets/i18n/es.json (Spanish)
{
  "quiz": {
    "title": "Juego de Preguntas",
    "question": "Pregunta",
    "of": "de",
    "submit": "Enviar Respuesta",
    "next": "Siguiente Pregunta",
    "score": "Puntuación",
    "correct": "¡Correcto!",
    "incorrect": "Incorrecto. ¡Inténtalo de nuevo!"
  }
}
```

### Using Translations
```typescript
// ✅ DO: Use translation service
import { TranslateService } from '@ngx-translate/core';

@Component({
  selector: 'app-quiz',
  standalone: true
})
export class QuizComponent {
  constructor(private translate: TranslateService) {
    // Set default language
    this.translate.setDefaultLang('en');
    
    // Use browser language or stored preference
    const browserLang = this.translate.getBrowserLang();
    this.translate.use(browserLang || 'en');
  }
  
  getTranslation(key: string): Observable<string> {
    return this.translate.get(key);
  }
}
```

```html
<!-- ✅ DO: Use translation pipe -->
<h1>{{ 'quiz.title' | translate }}</h1>
<p>{{ 'quiz.question' | translate }} {{ currentQuestionIndex + 1 }} {{ 'quiz.of' | translate }} {{ totalQuestions }}</p>
<button>{{ 'quiz.submit' | translate }}</button>
```

### Language Switcher
```typescript
// ✅ DO: Implement language switcher
@Component({
  selector: 'app-language-switcher',
  standalone: true
})
export class LanguageSwitcherComponent {
  languages = [
    { code: 'en', name: 'English' },
    { code: 'es', name: 'Español' },
    { code: 'fr', name: 'Français' }
  ];
  
  constructor(private translate: TranslateService) {}
  
  switchLanguage(lang: string): void {
    this.translate.use(lang);
    localStorage.setItem('preferred-language', lang);
  }
}
```

## Date/Time Formatting

### Locale-Specific Dates
```typescript
// ✅ DO: Use locale-aware date formatting
import { DatePipe } from '@angular/common';
import { LOCALE_ID } from '@angular/core';

@Component({
  providers: [{ provide: LOCALE_ID, useValue: 'es-ES' }]
})
export class QuizComponent {
  constructor(private datePipe: DatePipe) {}
  
  formatDate(date: Date): string {
    return this.datePipe.transform(date, 'medium', 'es-ES') || '';
    // Output: "24 dic 2024, 12:00:00"
  }
}
```

