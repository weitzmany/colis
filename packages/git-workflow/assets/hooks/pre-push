#!/bin/sh
# Pre-push hook - Run tests before pushing
# Part of @your-org/git-workflow package
# Version: 1.0.0

set -e

echo "🧪 Running pre-push checks..."

# Check if npm/yarn/pnpm is available
if command -v npm >/dev/null 2>&1; then
  PKG_MANAGER="npm"
elif command -v yarn >/dev/null 2>&1; then
  PKG_MANAGER="yarn"
elif command -v pnpm >/dev/null 2>&1; then
  PKG_MANAGER="pnpm"
else
  echo "⚠️  No package manager found. Skipping pre-push checks."
  exit 0
fi

# Run tests if test script exists
if $PKG_MANAGER run --silent test --help >/dev/null 2>&1; then
  echo "  → Running tests..."
  $PKG_MANAGER run test
else
  echo "  ⊘ No test script found. Skipping."
fi

echo "✅ Pre-push checks passed!"
exit 0
