{
  "name": "@colis/rig",
  "version": "1.0.4",
  "description": "Foundational development toolkit with port management, tech detection, project initialization, and shared utilities for all projects",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "@colis/rig": "./bin/core",
    "port-manager": "./bin/port-manager",
    "tech-detect": "./bin/tech-detect",
    "domain-manager": "./bin/domain-manager",
    "rig-setup": "./bin/setup"
  },
  "exports": {
    ".": "./dist/index.js",
    "./features/port-manager": "./dist/features/port-manager/index.js",
    "./features/tech-detector": "./dist/features/tech-detector/index.js",
    "./features/domain-manager": "./dist/features/domain-manager/index.js",
    "./features/project-initialization": "./dist/features/project-initialization/index.js",
    "./rules": "./rules",
    "./commands": "./commands"
  },
  "files": [
    "dist",
    "bin",
    "lib",
    "rules",
    "commands",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "clean:port-registry": "tsx scripts/clean-port-registry.ts",
    "prepublishOnly": "npm run clean && npm run build",
    "postinstall": "node lib/postinstall.js",
    "release:patch": "npm version patch && npm run clean && npm run build && npm publish",
    "release:minor": "npm version minor && npm run clean && npm run build && npm publish",
    "release:major": "npm version major && npm run clean && npm run build && npm publish"
  },
  "keywords": [
    "core",
    "port-manager",
    "development-tools",
    "cursor-rules",
    "cursor-commands"
  ],
  "author": "Colis",
  "license": "MIT",
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@colis/logbook": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "glob": "^10.5.0",
    "globals": "^17.0.0",
    "inquirer": "^9.2.12",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.6.5",
    "pg": "^8.11.3",
    "semver": "^7.7.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/semver": "^7.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "glob": "^10.5.0"
  }
}
