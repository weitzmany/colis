#!/usr/bin/env node

/**
 * Tech Detect CLI Entry Point
 */

import { program } from 'commander';
import { detectCommand } from '../dist/features/tech-detector/cli/commands/detect.js';

program
  .name('tech-detect')
  .description('Detect technology stack of a project')
  .version('1.0.0');

program
  .command('detect')
  .alias('scan')
  .description('Detect technology stack')
  .option('-p, --path <path>', 'Project path (default: current directory)')
  .option('-s, --save', 'Save detected tech stack to config files')
  .option('-f, --format <format>', 'Output format (text, json, table)', 'text')
  .option('-u, --update', 'Update existing tech stack')
  .option('--check-standards', 'Check against standards and show warnings (default: true)', true)
  .option('--skip-warnings', 'Skip standards warnings')
  .option('--no-interactive', 'Non-interactive mode (no prompts)')
  .action(detectCommand);

// Default command
program
  .option('-p, --path <path>', 'Project path (default: current directory)')
  .option('-s, --save', 'Save detected tech stack to config files')
  .option('-f, --format <format>', 'Output format (text, json, table)', 'text')
  .option('-u, --update', 'Update existing tech stack')
  .option('--check-standards', 'Check against standards and show warnings (default: true)', true)
  .option('--skip-warnings', 'Skip standards warnings')
  .option('--no-interactive', 'Non-interactive mode (no prompts)')
  .action(detectCommand);

program.parse();




