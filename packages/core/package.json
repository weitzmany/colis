{
  "name": "@your-org/core",
  "version": "1.0.0",
  "description": "Core package with features, rules, experts, and commands",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "port-manager": "./bin/port-manager",
    "tech-detect": "./bin/tech-detect",
    "domain-manager": "./bin/domain-manager"
  },
  "exports": {
    ".": "./dist/index.js",
    "./features/port-manager": "./dist/features/port-manager/index.js",
    "./features/tech-detector": "./dist/features/tech-detector/index.js",
    "./features/domain-manager": "./dist/features/domain-manager/index.js",
    "./rules": "./rules",
    "./commands": "./commands"
  },
  "files": [
    "dist",
    "bin",
    "rules",
    "commands",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "core",
    "port-manager",
    "development-tools",
    "cursor-rules",
    "cursor-commands"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "glob": "^10.5.0",
    "inquirer": "^9.2.12",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.6.5",
    "pg": "^8.11.3",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
