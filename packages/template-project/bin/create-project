#!/usr/bin/env node

/**
 * Create Project CLI Entry Point
 * 
 * Main entry point for creating new projects from templates
 */

import { program } from 'commander';
import { createCommand } from '../dist/cli/commands/create.js';
import { updateCommand } from '../dist/cli/commands/update.js';

program
  .name('create-project')
  .description('Create a new project from a template')
  .version('1.0.0');

program
  .command('create')
  .alias('new')
  .description('Create a new project')
  .argument('[project-name]', 'Project name')
  .option('-t, --template <type>', 'Template type (angular, slim, full-stack, frontend, backend, api)')
  .option('-p, --package-manager <manager>', 'Package manager (npm, yarn, pnpm)', 'npm')
  .option('--skip-deps', 'Skip dependency installation')
  .option('--skip-git', 'Skip git initialization')
  .option('--skip-init', 'Skip Project Initialization (not recommended)')
  .option('--skip-task-manager', 'Skip Task Manager initialization')
  .option('--overwrite', 'Overwrite existing files')
  .option('--skip-existing', 'Skip existing files (default)')
  .option('--dry-run', 'Show what would be created without making changes')
  .option('-d, --description <text>', 'Project description')
  .option('-a, --author <name>', 'Author name')
  .option('-l, --license <type>', 'License type (MIT, Apache-2.0, etc.)')
  .option('--use-ng-cli', 'Use Angular CLI (ng new) to generate Angular project (default for Angular)')
  .option('--no-use-ng-cli', 'Use templates instead of Angular CLI for Angular projects')
  .action(async (projectName, options) => {
    // Ensure projectName is a string, not an object
    const name = typeof projectName === 'string' ? projectName : (projectName ? String(projectName) : undefined);
    await createCommand({
      projectName: name ? name.trim() : undefined,
      template: options.template,
      packageManager: options.packageManager,
      skipDeps: options.skipDeps,
      skipGit: options.skipGit,
      skipInit: options.skipInit,
      skipTaskManager: options.skipTaskManager,
      overwrite: options.overwrite,
      skipExisting: options.skipExisting,
      dryRun: options.dryRun,
      description: options.description,
      author: options.author,
      license: options.license,
      useNgCli: options.useNgCli,
    });
  });

program
  .command('update')
  .description('Update an existing project (sync rules, commands, and configurations)')
  .option('--overwrite', 'Force overwrite all files regardless of hash')
  .option('--delete-orphaned', 'Delete files from project that no longer exist in core package')
  .option('--skip-rules', 'Skip synchronizing rules')
  .option('--skip-commands', 'Skip synchronizing commands')
  .option('--check-only', 'Check what would be updated without making changes')
  .action(async (options) => {
    await updateCommand({
      overwrite: options.overwrite,
      deleteOrphaned: options.deleteOrphaned,
      skipRules: options.skipRules,
      skipCommands: options.skipCommands,
      checkOnly: options.checkOnly,
    });
  });

// Default command - handle when project name is passed directly
program
  .argument('[project-name]', 'Project name')
  .action(async (projectName, options) => {
    // Ensure projectName is a string, not an object
    const name = typeof projectName === 'string' ? projectName : (projectName ? String(projectName) : undefined);
    if (name && name.trim().length > 0) {
      await createCommand({ projectName: name.trim() });
    } else {
      program.help();
    }
  });

program.parse(process.argv);
